<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="5" author="Zverev-DE">
        <createTable tableName="debts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="from_user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_debts_users" references="users(id)"/>
            </column>
            <column name="amount" type="NUMERIC(10,2)">
                <constraints nullable="true"/>
            </column>
            <column name="to_user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_debts_users" references="users(id)"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>